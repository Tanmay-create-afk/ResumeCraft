# =============================================================================
#  ResumeCraft — .gitignore
#  Full security-hardened rules for a Node.js + Vite + React + MongoDB project
# =============================================================================


# ─────────────────────────────────────────────
# 🔐 SECURITY — NEVER COMMIT THESE
# ─────────────────────────────────────────────

# Environment variables (contains DB passwords, JWT secrets, API keys)
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env.*.local

# Secret / key files
*.pem
*.key
*.cert
*.p12
*.pfx
*.crt
*.csr
secrets.json
secrets.yaml
secrets.yml
credentials.json
service-account.json

# AWS / Cloud credentials
.aws/
.gcloud/
.azure/


# ─────────────────────────────────────────────
# 📦 DEPENDENCIES — Never commit node_modules
# ─────────────────────────────────────────────

node_modules/
Frontend/node_modules/
backend/node_modules/
**/node_modules/

# Package manager lock conflicts (keep only one lock file per package manager)
# Uncomment the one you DON'T use:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
# bun.lockb


# ─────────────────────────────────────────────
# 🏗️ BUILD OUTPUT — Auto-generated, don't commit
# ─────────────────────────────────────────────

# Vite / React build output
Frontend/dist/
Frontend/build/
dist/
build/
out/
.output/
.vercel/
.netlify/

# TypeScript compiled output
*.js.map
*.d.ts.map


# ─────────────────────────────────────────────
# ⚡ VITE / REACT CACHE
# ─────────────────────────────────────────────

Frontend/.vite/
.vite/
*.local
vite.config.js.timestamp-*
vite.config.ts.timestamp-*


# ─────────────────────────────────────────────
# 🖥️ OS FILES — Never useful in repos
# ─────────────────────────────────────────────

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*


# ─────────────────────────────────────────────
# 🛠️ EDITOR & IDE FILES
# ─────────────────────────────────────────────

# VS Code workspace settings (keep .vscode/extensions.json if you want recommended extensions)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# Vim / Neovim
*.swp
*.swo
*~
Session.vim
.netrwhist

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-workspace
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
sftp-config.json
Package Control.last-run
Package Control.ca-list
Package Control.ca-bundle
Package Control.system-ca-bundle


# ─────────────────────────────────────────────
# 🧪 TESTING & COVERAGE
# ─────────────────────────────────────────────

coverage/
.coverage
*.lcov
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
cypress/screenshots/
cypress/videos/


# ─────────────────────────────────────────────
# 📝 LOGS — Never commit log files
# ─────────────────────────────────────────────

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*


# ─────────────────────────────────────────────
# 🗄️ DATABASE
# ─────────────────────────────────────────────

# Local SQLite / offline DB files
*.sqlite
*.sqlite3
*.db
*.db-journal

# MongoDB dumps
dump/
mongodump/


# ─────────────────────────────────────────────
# 📎 MISC
# ─────────────────────────────────────────────

# Temporary files
tmp/
temp/
.tmp/
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej

# Optional npm cache
.npm/

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Parcel cache
.parcel-cache/

# SvelteKit / Next.js
.svelte-kit/
.next/
.nuxt/

# Yarn
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Rush
common/temp/

# Duplicate nested clone
ResumeCraft/
